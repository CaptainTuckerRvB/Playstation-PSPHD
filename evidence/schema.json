{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/psphd/evidence.schema.json",
  "title": "PSPHD Research Evidence Record",
  "description": "A traceable research finding. Use UNKNOWN when a value is not established.",
  "type": "object",
  "required": [
    "id",
    "status",
    "target",
    "emulator_version",
    "game",
    "subsystem",
    "finding",
    "evidence",
    "confidence",
    "related_findings",
    "reproduction_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{5}$"
    },
    "status": {
      "type": "string",
      "enum": ["OBSERVED", "VERIFIED", "INFERRED", "UNKNOWN"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "emulator_version": {
      "type": "string",
      "minLength": 1
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "subsystem": {
      "type": "string",
      "minLength": 1
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "locator", "description"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]
    },
    "related_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reproduction_status": {
      "type": "string",
      "enum": ["REPRODUCED", "NOT_REPRODUCED", "NOT_APPLICABLE", "UNKNOWN"]
    }
  },
  "additionalProperties": false
}